# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://smartcar:smartcar@localhost:5432/smartcar

# Auth
JWT_SECRET=replace-with-a-random-secret-at-least-16-chars
JWT_EXPIRES_IN=3600

# Initial admin account (used by prisma/seed.ts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# MQTT broker
MQTT_URL=mqtts://your-broker-host:8883
MQTT_USER=backend
MQTT_PASS=
MQTT_CLIENT_ID_PREFIX=backend

# Commands and device state
CMD_TTL_SECONDS=30
CMD_ACK_TIMEOUT_SECONDS=10
DEVICE_OFFLINE_AFTER_SECONDS=15

# Manual control
CONTROL_LOCK_TTL_SECONDS=10
MANUAL_MAX_RTT_MS=500
DRIVE_RATE_LIMIT_PER_SEC=10
DRIVE_TTL_MS=500
PING_INTERVAL_ACTIVE_SECONDS=2
PING_INTERVAL_IDLE_SECONDS=10

# Telemetry sampling and retention
TELEMETRY_SAMPLE_INTERVAL_SECONDS=2
TELEMETRY_MAX_AGE_SECONDS=5
RETENTION_TELEMETRY_DAYS=14
RETENTION_EVENTS_DAYS=90
RETENTION_COMMANDS_DAYS=30

# Analytics and export
ANALYTICS_STOP_MARGIN_CM=10
EXPORT_MAX_RANGE_DAYS=7
